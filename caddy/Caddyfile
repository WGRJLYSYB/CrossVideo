{
    default_sni {$CADDY_SITE_ADDRESS}
}

http://127.0.0.1 {
    handle /health {
        respond "OK" 200
    }
}

https://{$CADDY_SITE_ADDRESS} {
    tls /data/certs/fullchain.pem /data/certs/privkey.pem
    encode gzip

    header {
        # 防点击劫持，禁止iframe嵌入
        X-Frame-Options "DENY"
        # 禁止MIME嗅探，防止类型混淆攻击
        X-Content-Type-Options "nosniff"
        # HSTS 强制HTTPS（长期）
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # 推荐CSP，现代XSS防护，替代过时X-XSS-Protection
        Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://*.sentry.io; script-src 'self' blob:; worker-src 'self' blob:;"
        # 引用策略
        Referrer-Policy "strict-origin-when-cross-origin"
        # 关闭无用设备权限
        Permissions-Policy "geolocation=(),camera=(),microphone=()"
        # 移除 Caddy 自身的 Server 标识（部分版本 Caddy 会带）
        -Server
        -Via
    }

    handle /api/* {
        reverse_proxy backend:8000 {
            header_down -Server
            header_down -Via
        }
    }

    handle_path /admin* {
        reverse_proxy frontend:80 {
            header_down -Server
            header_down -Via
        }
    }
}

http://{$CADDY_SITE_ADDRESS} {
    handle /.well-known/acme-challenge/* {
        root * /srv
        file_server
    }

    handle {
        redir https://{$CADDY_SITE_ADDRESS}{uri} permanent
    }
}