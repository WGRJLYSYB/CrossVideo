CROSSVIDEO_SECRET_KEY=replace-with-a-random-secret
CROSSVIDEO_DATABASE_URL=postgresql+psycopg://crossvideo:replace-with-a-strong-password@localhost:5432/crossvideo
CROSSVIDEO_ACCESS_TOKEN_EXPIRE_MINUTES=43200
CROSSVIDEO_CORS_ORIGINS=["*"]

POSTGRES_DB=crossvideo
POSTGRES_USER=crossvideo
POSTGRES_PASSWORD=replace-with-a-strong-password
WEBDAV_URL=https://dav.jianguoyun.com/dav/
WEBDAV_USER=your_email@domain.com
WEBDAV_PASSWORD=your_webdav_app_password
WEBDAV_BACKUP_DIR=/crossvideo-backups
DB_BACKUP_ENABLED=true
DB_BACKUP_ENCRYPTION_PASSWORD=your_backup_encrypt_secret_key

CADDY_SITE_ADDRESS=your.server.ip
CADDY_ACME_EMAIL=your_real_email@example.com
CADDY_ENABLE_ACME=true